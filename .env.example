# Copy these values into your PowerShell session. Never commit a real key.
DASHSCOPE_API_KEY=your-bailian-api-key
BAILIAN_APP_ID=your-bailian-agent-app-id
# Only set this when the app belongs to a non-default workspace.
BAILIAN_WORKSPACE_ID=your-workspace-id
# Optional: defaults to the Beijing Bailian endpoint.
BAILIAN_APP_ENDPOINT=https://dashscope.aliyuncs.com/api/v1/apps
# Only used when BAILIAN_APP_ID is empty.
OPENAI_MODEL=qwen-plus
